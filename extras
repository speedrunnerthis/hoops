const BD=[{spd:2.2,gap:2.8,st:.008,rt:3.5,jp:.004,mm:[.6,.9],pf:.05,osp:2.6,dr:.008,sh:2.2,err:.5},{spd:2.7,gap:2.1,st:.03,rt:2.5,jp:.015,mm:[.78,.98],pf:.2,osp:3.4,dr:.012,sh:1.6,err:.24},{spd:3.4,gap:1.7,st:.06,rt:1.6,jp:.03,mm:[.85,1],pf:.4,osp:3.9,dr:.02,sh:1.2,err:.14},{spd:4.2,gap:1.4,st:.1,rt:1,jp:.05,mm:[.9,1],pf:.6,osp:4.4,dr:.03,sh:.9,err:.07}];
function bot(b,h,dt){if(b.fall>0||b.cel)return;const D=BD[set.diff],hd=Math.hypot(b.x-h.x,b.z-h.z);b.ai=(b.ai||0)+dt;
  if(b.ball){const d=Math.hypot(b.x-H.x,b.z-H.z);
    if(!b.ch){if(d>R3-.6)move(b,H.x-b.x+Math.sin(t)*2,H.z-b.z,dt,D.osp);else{move(b,0,0,dt,0);if(b.ai>D.sh&&!b.air&&Math.random()<.03){b.ch=1;b.m=0}}if(b.dl>0&&Math.random()<D.dr)dribble(b)}
    else{b.ty=Math.atan2(H.x-b.x,H.z-b.z);b.m+=dt*SR;if(b.m>=(b.tgt=b.tgt||(Math.random()<D.pf?.93+Math.random()*.06:lp(D.mm[0],D.mm[1],Math.random())))){b.tgt=0;b.ai=0;release(b)}}}
  else if(h.ball){const dd=Math.hypot(H.x-h.x,H.z-h.z)||1,gx=h.x+(H.x-h.x)/dd*D.gap,gz=h.z+(H.z-h.z)/dd*D.gap;
    if(Math.hypot(gx-b.x,gz-b.z)>.4)move(b,gx-b.x,gz-b.z,dt,D.spd);else{move(b,0,0,dt,0);b.ty=Math.atan2(h.x-b.x,h.z-b.z)}
    b.react=hd>2?0:(b.react||0)+dt;if(hd<1.4&&h.dt<=0&&b.react>D.rt&&Math.random()<D.st){steal(b,h);b.react=0}
    if(h.ch&&hd<2.5&&b.y<=.01&&Math.random()<D.jp)jump(b)}
  else if(loose)move(b,loose.x-b.x,loose.z-b.z,dt,D.spd+.6)}
